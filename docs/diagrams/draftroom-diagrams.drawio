        <mxCell id="n213" value="&lt;ExportMenu&gt; → &quot;Export Markdown&quot;" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="12860" width="115" height="64" as="geometry"/></mxCell>
        <mxCell id="n214" value="&lt;ExportMenu&gt; → &quot;Export PDF&quot;" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="175" y="12860" width="115" height="50" as="geometry"/></mxCell>
        <mxCell id="n215" value="editor.getHTML()&lt;br&gt;(live client content)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="12990" width="115" height="78" as="geometry"/></mxCell>
        <mxCell id="n216" value="window.print()&lt;br&gt;Tailwind print: variants hide all&lt;br&gt;chrome, leaving only .print-area&lt;br&gt;→ browser's native print-to-PDF" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="175" y="12990" width="115" height="120" as="geometry"/></mxCell>
        <mxCell id="n217" value="htmlToMarkdown() walker&lt;br&gt;(lib/export/markdown.ts — hand-rolled,&lt;br&gt;safe because content HTML only ever comes&lt;br&gt;from our own fixed sanitize-html allow-list)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="890" y="13120" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="n218" value="Blob download — no network&lt;br&gt;call, no server round-trip" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="13250" width="115" height="78" as="geometry"/></mxCell>
        <mxCell id="e219" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n213" target="n215"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e220" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n215" target="n217"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e221" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n217" target="n218"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e222" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n214" target="n216"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="Approach_Rationale" name="Approach &amp; Rationale">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rtitle" value="Draftroom — Approach &amp; Rationale (why it's built this way)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F110E;strokeColor=none;fontColor=#D4F36B;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="44" as="geometry"/></mxCell>
        <mxCell id="ch233" value="Server Components for reads, Route Handlers for writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb234" value="Dashboard, the auth gate, and the document-open page query Prisma directly&lt;br&gt;from a Server Component — no API hop for pure reads, lower TTFB. The editor's&lt;br&gt;interactive calls (autosave, conflict poll, presence, sharing) run from client&lt;br&gt;state after mount, so those go through real API routes under /api instead." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch235" value="Lightweight HMAC-signed cookie session (no auth provider)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb236" value="The brief explicitly allows seeded accounts / mocked / lightweight login to keep&lt;br&gt;scope reasonable. The cookie is still real: httpOnly, sameSite=lax, HMAC-SHA256&lt;br&gt;signed payload verified with crypto.timingSafeEqual, 7-day expiry checked&lt;br&gt;server-side on every request — enough to demonstrate the pattern without&lt;br&gt;pulling in a full auth framework for a 4–6 hour build." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="120" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch237" value="Version-int optimistic concurrency, not locks / websockets / CRDT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb238" value="A single Int version column plus an atomic conditional updateMany(where:&lt;br&gt;{id, version}) replaces an earlier timestamp-compare design (timestamp precision&lt;br&gt;can race). Real-time collaborative merging (OT/CRDT) is explicitly out of the&lt;br&gt;brief's scope — the requirement is just &quot;don't silently overwrite,&quot; satisfied by&lt;br&gt;a 409 on the next save attempt plus a 10s poll, with no extra infra." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch239" value="Presence stored in Postgres, not in-memory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb240" value="Vercel serverless function instances don't share memory, so an in-process&lt;br&gt;Map of &quot;who's viewing&quot; would silently miss other instances in production.&lt;br&gt;A DB upsert + windowed query (25s activity window) is simple, serverless-safe,&lt;br&gt;and reuses the exact same access-gating as every other document route." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="330" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch241" value="Single access-control chokepoint: lib/access.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb242" value="getAccessRole() re-derives OWNER / EDITOR / VIEWER / null from Document.ownerId&lt;br&gt;+ Share on every call; requireRole() enforces it. Every document-scoped route&lt;br&gt;(GET/PATCH/DELETE documents, PUT/DELETE shares, POST presence) calls through&lt;br&gt;this one function instead of re-implementing its own ownership check — and the&lt;br&gt;404-vs-403 split deliberately hides a document's existence from users with zero&lt;br&gt;access to it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch243" value="Sanitized HTML as the content column (not JSON/ProseMirror doc, not Markdown)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="510" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb244" value="Tiptap reads and writes HTML directly, so storing HTML avoids a serialize/&lt;br&gt;deserialize layer. sanitize-html's fixed allow-list runs on every write path&lt;br&gt;(editor save and import conversion), which is also what makes the hand-rolled&lt;br&gt;Markdown export safe without needing a general-purpose HTML parser on the way&lt;br&gt;back out — the input shape is fully constrained by what we ourselves wrote." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="540" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch245" value="Server-side file conversion on import, not raw blob storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb246" value=".txt / .md / .docx (via mammoth) are converted to sanitized HTML and become a&lt;br&gt;real, immediately-editable Document — matching the brief's intent that upload be&lt;br&gt;a &quot;product-relevant&quot; step, not just file storage. Unsupported types are rejected&lt;br&gt;with 415, empty/corrupt files with 422, oversized files with 413." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch247" value="Deployment: Vercel + Neon, forced Node runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="720" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb248" value="export const runtime = &quot;nodejs&quot; on every API route, since Prisma, mammoth, and&lt;br&gt;sanitize-html all require Node APIs unavailable on the Edge runtime. Build script&lt;br&gt;is `prisma migrate deploy &amp;&amp; next build` with `postinstall: prisma generate`, so&lt;br&gt;every deploy applies pending migrations automatically against the same Neon&lt;br&gt;database used locally." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="750" width="670" height="160" as="geometry"/></mxCell>
        <mxCell id="ch249" value="Deliberate scope cuts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A2E12;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="670" height="30" as="geometry"/></mxCell>
        <mxCell id="cb250" value="No real-time collaborative editing (OT/CRDT) or websockets — conflict is&lt;br&gt;surfaced, not merged. No comment/suggestion mode. No full version history (only&lt;br&gt;last-editor name + conflict detection). No global toast system — sharing uses&lt;br&gt;inline error + optimistic rollback instead. &quot;Fix first&quot; selects/scrolls to the&lt;br&gt;first placeholder rather than a fully custom highlight overlay." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE0D7;fontSize=11;align=left;verticalAlign=top;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="670" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
