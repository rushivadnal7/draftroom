        <mxCell id="role_h" value="enum Role" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#333333;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="100" width="260" height="32" as="geometry"/></mxCell>
        <mxCell id="role_r0" value="    EDITOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1220" y="132" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="role_r1" value="    VIEWER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1220" y="158" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="roleNote" value="OWNER is implicit: it is whichever&lt;br&gt;User.id equals Document.ownerId.&lt;br&gt;It is never stored as a Share row —&lt;br&gt;Role only covers granted (non-owner) access." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="owns&lt;br&gt;(ownerId)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user_h" target="doc_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="last edited&lt;br&gt;(updatedById, nullable,&lt;br&gt;SetNull on delete)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=oval;startFill=0;endArrow=open;dashed=1;strokeColor=#999999;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="user_h" target="doc_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="has shares" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="doc_h" target="share_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="is shared with" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user_h" target="share_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="has viewers" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="doc_h" target="pres_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="is present in" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="user_h" target="pres_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="role :" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="share_h" target="role_h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend&lt;br&gt;PK = primary key   FK = foreign key&lt;br&gt;UQ = unique constraint   IDX = index&lt;br&gt;—▶ one-to-many   —→ nullable, SetNull on delete" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="engineNote" value="Engine notes&lt;br&gt;Postgres (hosted on Neon), accessed only through Prisma Client — no raw SQL in route handlers.&lt;br&gt;All ids are cuid() strings (collision-resistant, sortable-ish, generated app-side, not DB serials).&lt;br&gt;Share and Presence both cascade-delete when their Document or User is deleted, so a removed&lt;br&gt;document/user never leaves orphaned access-control or presence rows behind.&lt;br&gt;Single migration so far: prisma/migrations/20261020123000_init (schema evolves via&lt;br&gt;`prisma migrate dev` locally, `prisma migrate deploy` runs automatically on every Vercel build)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="760" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="System_Architecture_Workflow" name="System Architecture &amp; Workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="13440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="band223" value="" style="rounded=0;html=1;fillColor=#6C8EBF;opacity=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="13370" as="geometry"/></mxCell>
        <mxCell id="lh224" value="Browser&lt;br&gt;(Client Components)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="band225" value="" style="rounded=0;html=1;fillColor=#9673A6;opacity=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="260" height="13370" as="geometry"/></mxCell>
        <mxCell id="lh226" value="Next.js Server&lt;br&gt;(Server Components / Pages)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="band227" value="" style="rounded=0;html=1;fillColor=#D79B00;opacity=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="260" height="13370" as="geometry"/></mxCell>
        <mxCell id="lh228" value="API Route Handlers&lt;br&gt;(route.ts, Node runtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D79B00;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="band229" value="" style="rounded=0;html=1;fillColor=#82B366;opacity=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="260" height="13370" as="geometry"/></mxCell>
        <mxCell id="lh230" value="Lib / Domain Logic&lt;br&gt;(src/lib/*)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="band231" value="" style="rounded=0;html=1;fillColor=#666666;opacity=6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1150" y="70" width="260" height="13370" as="geometry"/></mxCell>
        <mxCell id="lh232" value="Database&lt;br&gt;(Prisma → Postgres/Neon)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="70" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="mainTitle" value="Draftroom — System Architecture &amp; Workflow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F110E;strokeColor=none;fontColor=#D4F36B;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1380" height="44" as="geometry"/></mxCell>
        <mxCell id="note_access" value="Cross-cutting — lib/access.ts&lt;br&gt;getAccessRole(userId, documentId) is the ONLY place permission is decided: it re-derives&lt;br&gt;OWNER | EDITOR | VIEWER | null from Document.ownerId + Share on every call — no route ever&lt;br&gt;trusts a client-sent role. requireRole() throws 404 for no access (hides whether the document&lt;br&gt;exists) vs 403 for the wrong role. Used by: GET/PATCH/DELETE documents, PUT/DELETE&lt;br&gt;shares, POST presence — see the green &quot;getAccessRole()&quot; box repeated through this diagram." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="660" height="110" as="geometry"/></mxCell>
        <mxCell id="note_sanitize" value="Cross-cutting — lib/sanitize.ts&lt;br&gt;sanitizeDocumentHtml() (sanitize-html, fixed allow-list) runs on EVERY write path that stores&lt;br&gt;HTML: editor autosave (PATCH) and file-import conversion. Because stored HTML is always this&lt;br&gt;known-safe subset, the hand-rolled Markdown export walker can safely assume its shape —&lt;br&gt;no general-purpose HTML parser needed on the way back out." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="700" height="110" as="geometry"/></mxCell>
        <mxCell id="t8" value="1 — Sign in (pick a seeded profile)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F110E;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1380" height="40" as="geometry"/></mxCell>
        <mxCell id="n9" value="/login — UserSwitcher&lt;br&gt;click a seeded profile card" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="n10" value="fetch POST /api/auth/login&lt;br&gt;{ userId }" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="n11" value="api/auth/login/route.ts&lt;br&gt;POST handler" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="610" y="530" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="n12" value="prisma.user.findUnique&lt;br&gt;({ id: userId })&lt;br&gt;(401 if not found)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;rounded=1;arcSize=8;spacing=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1170" y="660" width="240" height="64" as="geometry"/></mxCell>
